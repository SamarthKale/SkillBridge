rules_version = '2';

// ===============================================================
// SkillBridge - Firestore Security Rules  (PROTOTYPE - review before public launch)
// ===============================================================
//
// Collections
// -----------
// projects/{id}         Client-posted opportunities that students browse & apply to.
//   title, company, category, budget, location, remote(bool), skills[],
//   description, responsibilities, requirements, experienceRequired,
//   deadline, postedByUid, postedByName, postedAt(number)
//   -> Readable by any signed-in user. Writable only by the poster
//      (seed data has postedByUid == "" and is admin-written, bypassing rules).
//
// profiles/{uid}        One per user. Owned by that uid.
//   uid, role("student"|"client"), name, email, phone, location, photoUrl,
//   degree, college, branch, graduationYear(number), skills[],
//   experience, bio, resumeUrl, createdAt, updatedAt
//   -> Any signed-in user may read a profile (needed to show an applicant to
//      a client). Only the owner may create / update / delete it.
//
// applications/{appId}  appId == "<studentUid>_<projectId>"  (guarantees one per pair)
//   projectId, projectTitle, company, budget, studentUid, studentName,
//   intro, resumeUrl, status, appliedAt(number)
//   status in Applied|Under Review|Shortlisted|Accepted|Rejected
//   -> The student owns their applications. They create/read/delete;
//      status transitions are normally a client/admin action, but for this
//      mini-project the owner may also update non-status fields.
//
// messages/{id}         Flat chat messages tied to an application thread.
//   applicationId, projectTitle, company, studentUid, clientName,
//   fromClient(bool), text, sentAt(number)
//   -> Read/write limited to the student on that thread (studentUid).
//
// notifications/{id}    Lightweight per-user notifications.
//   uid, type, text, createdAt(number), read(bool)
//   -> Owner may read; owner may update only the `read` flag; no client create
//      (seed/admin only).
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function authed() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return authed() && request.auth.uid == uid;
    }
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }
    // True when the signed-in user posted the project with this id (i.e. is its client).
    function ownsProject(projectId) {
      return authed()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.postedByUid == request.auth.uid;
    }
    // True when the signed-in user is the student who sent this application.
    function isApplicant(appId) {
      return authed()
        && exists(/databases/$(database)/documents/applications/$(appId))
        && get(/databases/$(database)/documents/applications/$(appId)).data.studentUid == request.auth.uid;
    }
    // True when the signed-in user owns the project that this application was sent to.
    function ownsApplication(appId) {
      return authed()
        && exists(/databases/$(database)/documents/applications/$(appId))
        && ownsProject(get(/databases/$(database)/documents/applications/$(appId)).data.projectId);
    }

    // ---- Opportunities -------------------------------------------------
    match /projects/{projectId} {
      allow read: if authed();
      allow create: if authed()
        && request.resource.data.postedByUid == request.auth.uid;
      allow update, delete: if authed()
        && resource.data.postedByUid == request.auth.uid;
    }

    // ---- Profiles ----------------------------------------------------
    match /profiles/{uid} {
      allow read: if authed();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // ---- Resumes (base64 file; Storage needs the paid Blaze plan) -----
    // One per user. Any signed-in user may read (clients review applicants);
    // only the owner may write, and the file is capped at ~700 KB of base64.
    match /resumes/{uid} {
      allow read: if authed();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.dataBase64 is string
        && request.resource.data.dataBase64.size() < 700000;
      allow delete: if isOwner(uid);
    }

    // ---- Applications --------------------------------------------------
    match /applications/{appId} {
      // `get` on a missing doc must be allowed so "have I applied yet?" checks work
      // (a rule that dereferences a null `resource` would otherwise deny it).
      // The project's client can also read applications sent to their own projects.
      allow get: if authed() && (resource == null
        || resource.data.studentUid == request.auth.uid
        || ownsProject(resource.data.projectId));
      allow list: if authed() && (resource.data.studentUid == request.auth.uid
        || ownsProject(resource.data.projectId));
      allow create: if authed()
        && request.resource.data.studentUid == request.auth.uid
        && appId == request.auth.uid + '_' + request.resource.data.projectId
        && request.resource.data.status == 'Applied';
      allow update: if authed() && (
        // The student may edit their own application, but never its status.
        (resource.data.studentUid == request.auth.uid
          && unchanged('studentUid') && unchanged('projectId') && unchanged('status'))
        // The project's client may move it through the pipeline: ONLY `status` may change.
        || (ownsProject(resource.data.projectId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['Applied', 'Under Review', 'Shortlisted', 'Accepted', 'Rejected'])
      );
      allow delete: if authed() && resource.data.studentUid == request.auth.uid;
    }

    // ---- Messages ---------------------------------------------------
    match /messages/{msgId} {
      // The student on the thread, or the client who owns the project it is about, may read it.
      // The applicationId branches let a thread be queried by applicationId (the live
      // conversation view), which a studentUid-only check cannot prove for a query.
      allow read: if authed() && (resource.data.studentUid == request.auth.uid
        || isApplicant(resource.data.applicationId)
        || ownsApplication(resource.data.applicationId));
      allow create: if authed() && (
        // Student -> client
        (request.resource.data.studentUid == request.auth.uid
          && request.resource.data.fromClient == false)
        // Client -> student, only on an application sent to one of their own projects
        || (request.resource.data.fromClient == true
          && ownsApplication(request.resource.data.applicationId))
      );
      allow update, delete: if false;
    }

    // ---- Notifications ----------------------------------------------
    match /notifications/{noteId} {
      allow read: if authed() && resource.data.uid == request.auth.uid;
      // A user may create notifications addressed to themselves (e.g. "application submitted").
      allow create: if authed() && request.resource.data.uid == request.auth.uid;
      // Only allow flipping the `read` flag on your own notification.
      allow update: if authed()
        && resource.data.uid == request.auth.uid
        && unchanged('uid') && unchanged('type')
        && unchanged('text') && unchanged('createdAt');
      allow delete: if false;
    }

    // ---- AI Conversations -------------------------------------------
    // Strict owner-only access: each user can only read, create, update,
    // or clear their own AI conversation history document.
    match /ai_conversations/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.ownerUid == uid;
      allow delete: if isOwner(uid);
    }

    // Everything else denied by default.
  }
}
